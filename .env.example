# Desenvolvimento local somente. Nunca use estas credenciais em produção.
# NODE_ENV é definido pelos comandos/contêineres; o backend assume development.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
POSTGRES_USER=whatsflow
POSTGRES_PASSWORD=whatsflow_dev_only
POSTGRES_DB=whatsflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://whatsflow:whatsflow_dev_only@localhost:5432/whatsflow?schema=public
FRONTEND_PORT=5173
# Usado apenas pelo proxy Vite, nunca exposto no bundle do navegador.
API_PROXY_TARGET=http://localhost:3000

# Meta é opcional no bootstrap. Habilite somente após preencher todos os campos.
META_ENABLED=false
META_APP_SECRET=
# Token próprio para verificação GET (ao menos 32 caracteres aleatórios).
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_API_BASE_URL=https://graph.facebook.com
# Informe a versão ativa exibida no painel, por exemplo v25.0; sem default no código.
META_API_VERSION=
META_REQUEST_TIMEOUT_MS=10000
META_WORKER_POLL_MS=1000
